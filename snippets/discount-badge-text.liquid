{% doc %}
  Renders the configured discount badge text for a sale price.

  @param {number} price - Current product or variant price in cents.
  @param {number} compare_at_price - Original product or variant price in cents.

  @example
  {% render 'discount-badge-text', price: variant.price, compare_at_price: variant.compare_at_price %}
{% enddoc %}

{%- liquid
  assign saving = compare_at_price | minus: price
  if settings.save_badge_type == 'save_amount'
    assign saving_money = saving | money
    echo 'Save ' | append: saving_money
  else
    assign percentage_off = saving | times: 100.0 | divided_by: compare_at_price | round
    echo percentage_off | append: '% OFF'
  endif
-%}
