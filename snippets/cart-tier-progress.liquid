{% doc %}
  Renders the cart drawer tiered discount progress component.

  @param {object} cart - The current cart object.
  @param {object} section - The cart drawer section and its tier blocks.

  @example
  {% render 'cart-tier-progress', cart: cart, section: section %}
{% enddoc %}

{%- liquid
  assign tier_count = 0
  assign unlocked_count = 0
  assign next_tier = nil
  assign latest_unlocked_tier = nil

  for block in section.blocks
    if block.type == 'discount_tier' and block.settings.threshold > 0
      assign tier_count = tier_count | plus: 1
      assign threshold_cents = block.settings.threshold | times: 100 | round
      if cart.items_subtotal_price >= threshold_cents
        assign unlocked_count = unlocked_count | plus: 1
        assign latest_unlocked_tier = block
      elsif next_tier == nil
        assign next_tier = block
      endif
    endif
  endfor
-%}

{%- if tier_count > 0 -%}
  {%- liquid
    assign status_tier = next_tier
    assign status_template = next_tier.settings.before_message
    assign remaining_cents = 0
    if next_tier
      assign next_threshold_cents = next_tier.settings.threshold | times: 100 | round
      assign remaining_cents = next_threshold_cents | minus: cart.items_subtotal_price | at_least: 0
    else
      assign status_tier = latest_unlocked_tier
      assign status_template = latest_unlocked_tier.settings.after_message
    endif

    assign remaining_money = remaining_cents | money | strip_html
    assign threshold_cents = status_tier.settings.threshold | times: 100 | round
    assign threshold_money = threshold_cents | money | strip_html
    assign status_message = status_template | replace: '{amount}', remaining_money | replace: '{discount}', status_tier.settings.discount | replace: '{threshold}', threshold_money
    if unlocked_count == tier_count
      assign progress_percent = 100
    else
      assign target_position = unlocked_count | plus: 1 | times: 100.0 | divided_by: tier_count
      assign previous_position = unlocked_count | times: 100.0 | divided_by: tier_count
      assign previous_threshold = 0
      if latest_unlocked_tier
        assign previous_threshold = latest_unlocked_tier.settings.threshold | times: 100 | round
      endif
      assign interval_total = threshold_cents | minus: previous_threshold
      assign interval_current = cart.items_subtotal_price | minus: previous_threshold | at_least: 0
      assign interval_progress = interval_current | times: 1.0 | divided_by: interval_total | at_most: 1
      assign position_span = target_position | minus: previous_position
      assign progress_percent = position_span | times: interval_progress | plus: previous_position
    endif
  -%}

  <cart-tier-progress class="cart-tier-progress" style="--cart-tier-progress: {{ progress_percent }}%; --cart-tier-count: {{ tier_count | plus: 1 }};" data-unlocked-count="{{ unlocked_count }}">
    <p class="cart-tier-progress__status" data-tier-status aria-live="polite" aria-atomic="true">{{ status_message | escape }}</p>
    <div class="cart-tier-progress__visual" aria-hidden="true">
      <div class="cart-tier-progress__track"><span class="cart-tier-progress__fill" data-tier-fill></span></div>
      <div class="cart-tier-progress__tiers">
        <div class="cart-tier-progress__tier cart-tier-progress__tier--start is-unlocked">
          <span class="cart-tier-progress__marker" aria-hidden="true"></span>
          <span class="cart-tier-progress__threshold">{{ 0 | money | strip_html }}</span>
        </div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'discount_tier' and block.settings.threshold > 0 -%}
            {%- assign block_threshold_cents = block.settings.threshold | times: 100 | round -%}
            {%- assign tier_unlocked = false -%}
            {%- if cart.items_subtotal_price >= block_threshold_cents -%}{%- assign tier_unlocked = true -%}{%- endif -%}
            <div class="cart-tier-progress__tier{% if tier_unlocked %} is-unlocked{% endif %}" data-tier-marker {{ block.shopify_attributes }}>
              <span class="cart-tier-progress__marker"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" focusable="false" aria-hidden="true"><path d="M15.0049 2.00281C17.214 2.00281 19.0049 3.79367 19.0049 6.00281C19.0049 6.73184 18.8098 7.41532 18.4691 8.00392L23.0049 8.00281V10.0028H21.0049V20.0028C21.0049 20.5551 20.5572 21.0028 20.0049 21.0028H4.00488C3.4526 21.0028 3.00488 20.5551 3.00488 20.0028V10.0028H1.00488V8.00281L5.54065 8.00392C5.19992 7.41532 5.00488 6.73184 5.00488 6.00281C5.00488 3.79367 6.79574 2.00281 9.00488 2.00281C10.2001 2.00281 11.2729 2.52702 12.0058 3.35807C12.7369 2.52702 13.8097 2.00281 15.0049 2.00281ZM11.0049 10.0028H5.00488V19.0028H11.0049V10.0028ZM19.0049 10.0028H13.0049V19.0028H19.0049V10.0028ZM9.00488 4.00281C7.90031 4.00281 7.00488 4.89824 7.00488 6.00281C7.00488 7.05717 7.82076 7.92097 8.85562 7.99732L9.00488 8.00281H11.0049V6.00281C11.0049 5.00116 10.2686 4.1715 9.30766 4.02558L9.15415 4.00829L9.00488 4.00281ZM15.0049 4.00281C13.9505 4.00281 13.0867 4.81869 13.0104 5.85355L13.0049 6.00281V8.00281H15.0049C16.0592 8.00281 16.923 7.18693 16.9994 6.15207L17.0049 6.00281C17.0049 4.89824 16.1095 4.00281 15.0049 4.00281Z"></path></svg></span>
              <span class="cart-tier-progress__threshold">{{ block_threshold_cents | money | strip_html }}</span>
              <strong class="cart-tier-progress__discount">{{ block.settings.discount }}% OFF</strong>
              <span class="visually-hidden">{% if tier_unlocked %}Unlocked{% else %}Locked{% endif %}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <script type="application/json" data-cart-tier-config>
      {"cartAmount":{{ cart.items_subtotal_price | json }},"moneyFormat":{{ shop.money_format | json }},"tiers":[
        {%- assign config_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'discount_tier' and block.settings.threshold > 0 -%}
            {%- if config_index > 0 -%},{%- endif -%}
            {"discount":{{ block.settings.discount | json }},"threshold":{{ block.settings.threshold | times: 100 | round | json }},"beforeMessage":{{ block.settings.before_message | json }},"afterMessage":{{ block.settings.after_message | json }}}
            {%- assign config_index = config_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]}
    </script>
  </cart-tier-progress>
{%- endif -%}
