{% doc %}
  CocoPoco brand color palette.

  @example
  color: var(--color-cocopoco-pink);
{% enddoc %}

{% style %}
  :root {
    --color-cocopoco-pink: #e83e8c;
    --color-cocopoco-pink-mobile: #ec64a4;
    --color-blush-pink: #fedbef;
    --color-soft-blush: #feeef5;
    --color-deep-cocoa: #341824;
    --color-pure-white: #ffffff;
    --color-warm-white: #fffdfe;
    --color-rose-mist: #f9d5e6;
    --color-muted-rose: #b86a8a;
    --color-soft-gold: #f4c95d;
    --color-charcoal: #4a4145;
    --cp-product-card-background: {{ settings.product_card_background }};
    --cp-product-card-border: {{ settings.product_card_border }};
    --cp-product-card-border-mobile: {{ settings.product_card_border_mobile }};
    --cp-product-card-title: {{ settings.product_card_title }};
    --cp-product-card-description: {{ settings.product_card_description }};
    --cp-product-card-price: {{ settings.product_card_price }};
    --cp-product-card-compare-price: {{ settings.product_card_compare_price }};
    --cp-product-card-rating: {{ settings.product_card_rating }};
    --cp-product-card-rating-mobile: {{ settings.product_card_rating_mobile }};
    --cp-product-card-badge-background: {{ settings.product_card_badge_background }};
    --cp-product-card-badge-text: {{ settings.product_card_badge_text }};
    --cp-product-card-button-background: {{ settings.product_card_button_background }};
    --cp-product-card-button-background-mobile: {{ settings.product_card_button_background_mobile }};
    --cp-product-card-button-text: {{ settings.product_card_button_text }};
  }

  @media screen and (max-width: 749px) {
    :root {
      --color-cocopoco-pink: var(--color-cocopoco-pink-mobile);
      {% assign product_card_border = settings.product_card_border | downcase %}
      {% if product_card_border == '#e83e8c' %}
        --cp-product-card-border: var(--cp-product-card-border-mobile);
      {% endif %}
      --cp-product-card-rating: var(--cp-product-card-rating-mobile);
      --cp-product-card-button-background: var(--cp-product-card-button-background-mobile);
    }
  }
{% endstyle %}
