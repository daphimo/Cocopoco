{%- render 'cart-drawer' -%}

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "text", "id": "cart_heading", "label": "Cart heading", "default": "Your bag" },
    { "type": "checkbox", "id": "enable_tiered_discount_progress", "label": "Enable tiered discount progress bar", "default": true },
    { "type": "header", "content": "Dynamic discount message" },
    { "type": "checkbox", "id": "enable_dynamic_message_initial", "label": "Enable first message", "default": true },
    { "type": "text", "id": "dynamic_message_initial", "label": "First message", "info": "Shown before the first price threshold is reached.", "default": "₹99 flat shipping on every order" },
    { "type": "checkbox", "id": "enable_dynamic_message_1", "label": "Enable threshold 1 message", "default": true },
    { "type": "number", "id": "dynamic_message_threshold_1", "label": "Price threshold 1", "info": "Enter an amount in your store currency, for example 1499.", "default": 1499 },
    { "type": "text", "id": "dynamic_message_1", "label": "Message after threshold 1", "default": "You unlocked free shipping!" },
    { "type": "checkbox", "id": "enable_dynamic_message_2", "label": "Enable threshold 2 message", "default": true },
    { "type": "number", "id": "dynamic_message_threshold_2", "label": "Price threshold 2", "info": "The second threshold should be higher than the first.", "default": 1999 },
    { "type": "text", "id": "dynamic_message_2", "label": "Message after threshold 2", "default": "Your order just unlocked an extra reward!" },
    { "type": "checkbox", "id": "enable_dynamic_message_3", "label": "Enable threshold 3 message", "default": true },
    { "type": "number", "id": "dynamic_message_threshold_3", "label": "Price threshold 3", "info": "The third threshold should be higher than the second.", "default": 2499 },
    { "type": "text", "id": "dynamic_message_3", "label": "Message after threshold 3", "default": "Amazing! You unlocked our top cart reward!" },
    { "type": "text", "id": "recommendation_heading", "label": "Recommendation heading", "default": "Add a little extra joy ✨" },
    { "type": "product_list", "id": "recommended_products", "label": "Recommended products", "limit": 12 },
    { "type": "number", "id": "flat_shipping_amount", "label": "Flat shipping amount", "info": "Enter the amount in your store currency, for example 99.", "default": 99 },
    { "type": "checkbox", "id": "enable_minimum_order", "label": "Enable minimum order total", "default": false },
    { "type": "number", "id": "minimum_order_amount", "label": "Minimum order total", "info": "Includes the flat shipping amount.", "default": 499 },
    { "type": "text", "id": "minimum_order_message", "label": "Minimum order progress message", "info": "Use {amount} for the amount remaining and {minimum} for the required total.", "default": "Add {amount} more to reach the minimum order total of {minimum}." },
    { "type": "text", "id": "empty_heading", "label": "Empty cart heading", "default": "Your bag is feeling a little empty" },
    { "type": "text", "id": "empty_subtext", "label": "Empty cart subtext", "default": "Let's fix that with something cute." },
    { "type": "text", "id": "empty_button_text", "label": "Empty cart button text", "default": "Shop the joy" },
    { "type": "url", "id": "empty_button_link", "label": "Empty cart button link" },
    { "type": "text", "id": "continue_text", "label": "Continue shopping text", "default": "Continue shopping" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#E64D95" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#241226" }
  ],
  "blocks": [
    { "type": "discount_tier", "name": "Tiered discount progress", "limit": 3, "settings": [
      { "type": "number", "id": "discount", "label": "Discount", "default": 5 },
      { "type": "text", "id": "reward_label", "label": "Reward label", "info": "Optional. Enter any reward, for example Free Shipping, Free Gift, or Buy 2 Get 1. When blank, the numeric discount is shown; a discount of 0 defaults to Free Shipping." },
      { "type": "number", "id": "threshold", "label": "Price to achieve", "info": "Enter the amount in your store currency, for example 999.", "default": 999 },
      { "type": "text", "id": "before_message", "label": "Before success message", "info": "Use {amount}, {reward}, {discount}, or {threshold}.", "default": "Add item worth {amount} to get {reward}" },
      { "type": "text", "id": "after_message", "label": "After success message", "info": "Use {reward}, {discount}, or {threshold}.", "default": "Congratulations! You unlocked {reward}" }
    ] },
    { "type": "footer_utility", "name": "Footer utility", "limit": 2, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "sparkles", "options": [{ "value": "sparkles", "label": "Sparkles" }, { "value": "star", "label": "Star" }, { "value": "truck", "label": "Truck" }, { "value": "rotate", "label": "Rotate" }, { "value": "arrow-right", "label": "Arrow right" }, { "value": "none", "label": "None" }] },
      { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Cart benefit" }
    ] }
  ],
  "presets": [{ "name": "Cart drawer", "blocks": [{ "type": "footer_utility", "settings": { "icon": "truck", "text": "Dispatch in 24–48 hrs" } }] }]
}
{% endschema %}
