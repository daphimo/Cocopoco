{%- if predictive_search.performed -%}
  {%- liquid
    assign product_count = predictive_search.resources.products.size | at_most: 4
    assign collection_count = predictive_search.resources.collections.size | at_most: 4
    assign page_count = predictive_search.resources.pages.size | at_most: 4
    assign total_results = product_count | plus: collection_count | plus: page_count
  -%}
  <div id="predictive-search-results" role="listbox">
    {%- if total_results > 0 -%}
      <div id="predictive-search-results-groups-wrapper" class="predictive-search__results-groups-wrapper">
        {%- if product_count > 0 -%}
          <section class="predictive-search__result-group" aria-labelledby="predictive-search-products">
            <h2 id="predictive-search-products" class="predictive-search__heading">{{ 'templates.search.products' | t }}</h2>
            <ul class="predictive-search__results-list list-unstyled" role="group">
              {%- for product in predictive_search.resources.products limit: 4 -%}
                <li id="predictive-search-option-product-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false">
                  <a href="{{ product.url }}" class="predictive-search__item predictive-search__item--product link" tabindex="-1">
                    <span class="predictive-search__media">
                      {%- if product.featured_media != blank -%}
                        {{ product.featured_media | image_url: width: 180 | image_tag: class: 'predictive-search__image', widths: '90, 180', loading: 'lazy' }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'predictive-search__image placeholder-svg' }}
                      {%- endif -%}
                    </span>
                    <span class="predictive-search__item-content">
                      <span class="predictive-search__item-heading">{{ product.title | escape }}</span>
                      {%- if settings.predictive_search_show_price -%}<span class="predictive-search__price">{{ product.price | money }}</span>{%- endif -%}
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}
        {%- if collection_count > 0 -%}
          <section class="predictive-search__result-group" aria-labelledby="predictive-search-collections">
            <h2 id="predictive-search-collections" class="predictive-search__heading">{{ 'templates.search.collections' | t }}</h2>
            <ul class="predictive-search__results-list list-unstyled" role="group">
              {%- for collection in predictive_search.resources.collections limit: 4 -%}
                {%- assign title = collection.metafields.custom.display_name | default: collection.title -%}
                <li id="predictive-search-option-collection-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false">
                  <a href="{{ collection.url }}" class="predictive-search__item link" tabindex="-1">
                    <span class="predictive-search__type-mark" aria-hidden="true">C</span>
                    <span class="predictive-search__item-heading">{{ title | escape }}</span>
                    <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}
        {%- if page_count > 0 -%}
          <section class="predictive-search__result-group" aria-labelledby="predictive-search-pages">
            <h2 id="predictive-search-pages" class="predictive-search__heading">{{ 'templates.search.pages' | t }}</h2>
            <ul class="predictive-search__results-list list-unstyled" role="group">
              {%- for page in predictive_search.resources.pages limit: 4 -%}
                <li id="predictive-search-option-page-{{ forloop.index }}" class="predictive-search__list-item" role="option" aria-selected="false">
                  <a href="{{ page.url }}" class="predictive-search__item link" tabindex="-1">
                    <span class="predictive-search__type-mark" aria-hidden="true">P</span>
                    <span class="predictive-search__item-heading">{{ page.title | escape }}</span>
                    <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}
      </div>
    {%- else -%}
      <p class="predictive-search__empty">{{ 'templates.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}
    {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
    <div id="predictive-search-option-search-keywords" class="predictive-search__search-for-button">
      <button class="predictive-search__item predictive-search__item--term link" tabindex="-1" role="option" aria-selected="false">
        <span data-predictive-search-search-for-text>{{ 'templates.search.search_for' | t: terms: predictive_search.terms }}</span>
        <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
      </button>
    </div>
    <span class="hidden" data-predictive-search-live-region-count-value data-total-results="{{ total_results }}">
      {{ 'templates.search.results_with_count' | t: count: total_results }}
    </span>
  </div>
{%- endif -%}
