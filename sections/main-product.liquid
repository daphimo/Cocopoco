<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'main-product-custom.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'main-product-variant-gallery.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cust-pincode-checker.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-share-popup.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'stock-notify.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.show_sticky_checkout -%}
  {{ 'sticky-product-checkout.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'sticky-product-checkout.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --main-product-page-width: {{ settings.page_width | divided_by: 10.0 }}rem;
    --main-product-bg: {{ section.settings.background_color }};
    --main-product-accent: {{ section.settings.accent_color }};
    --main-product-padding-top: {{ section.settings.padding_top }}px;
    --main-product-padding-bottom: {{ section.settings.padding_bottom }}px;
    --main-product-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --main-product-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
{%- endstyle -%}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign fallback_collection = collection
  if fallback_collection == blank
    assign fallback_collection = product.collections | first
  endif
  assign collection_title = fallback_collection.metafields.custom.display_name | default: fallback_collection.title
  assign product_form_id = 'product-form-' | append: section.id
  assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
-%}

<product-info
  id="MainProduct-{{ section.id }}"
  class="main-product"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'page' | escape }}">
    <div class="main-product__inner">
      <nav class="main-product__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>
        <a
          href="{% if fallback_collection != blank %}{{ fallback_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
          data-product-collection-link
        >
<<<<<<< HEAD
          {%- if fallback_collection != blank %}{{ collection_title | escape }}{% else %}Shop{% endif -%}
=======
          {%- if fallback_collection != blank %}{{ fallback_collection.title | escape }}{% else %}Shop{% endif -%}
>>>>>>> 5f27724de2a2542292b7c93f210bc2915023c155
        </a>
        <span aria-hidden="true">/</span><span aria-current="page">{{ product.title | escape }}</span>
      </nav>

      <div class="main-product__layout">
        <div class="main-product__media">
          <div class="main-product__media-slider" role="list" aria-label="{{ product.title | escape }} media">
            {%- for media in product.media -%}
              {%- liquid
                assign is_primary_media = false
                if selected_variant.featured_media != blank
                  if media.id == selected_variant.featured_media.id
                    assign is_primary_media = true
                  endif
                elsif forloop.first
                  assign is_primary_media = true
                endif
              -%}
              <div
                class="main-product__media-slide{% if is_primary_media %} main-product__media-slide--primary{% endif %}"
                role="listitem"
                data-media-id="{{ section.id }}-{{ media.id }}"
              >
                {%- if media.media_type == 'image' -%}
                  {%- liquid
                    assign media_loading = 'lazy'
                    assign media_priority = 'auto'
                    if forloop.first
                      assign media_loading = 'eager'
                      assign media_priority = 'high'
                    endif
                  -%}
                  {{
                    media.preview_image
                    | image_url: width: 1600
                    | image_tag:
                      class: 'main-product__image',
                      widths: '360, 540, 720, 900, 1200, 1600',
                      sizes: '(min-width: 750px) 48vw, calc(100vw - 20px)',
                      loading: media_loading,
                      fetchpriority: media_priority,
                      alt: media.alt
                  }}
                {%- else -%}
                  {% render 'product-media', media: media, loop: false, variant_image: false %}
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="main-product__media-slide main-product__media-slide--primary">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg main-product__image' }}
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="main-product__details" id="ProductInfo-{{ section.id }}">
          {%- if rating_value != blank -%}
            <div
              class="main-product__reviews"
              role="img"
              aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
            >
              <span class="main-product__stars" aria-hidden="true">★★★★★</span><strong>{{ rating_value }}</strong>
              {%- if rating_count != blank -%}
                <span
                  >({{ rating_count }}
                  {{ 'accessibility.total_reviews' | t | default: 'reviews' }})</span
                >
              {%- endif %}
            </div>
          {%- endif -%}
          <h1 class="main-product__title">{{ product.title | escape }}</h1>
          {%- if product.metafields.custom.card_highlight.value != blank -%}
            <div class="main-product__highlight">{{ product.metafields.custom.card_highlight.value }}</div>
          {%- endif -%}

          <div class="main-product__price-row">
            <div class="main-product__price" id="price-{{ section.id }}" role="status">
              <span class="main-product__current-price">{{ selected_variant.price | money }}</span>
              {%- if selected_variant.compare_at_price > selected_variant.price -%}
                <s class="main-product__compare-price">{{ selected_variant.compare_at_price | money }}</s>
                {%- assign saving = selected_variant.compare_at_price | minus: selected_variant.price -%}
                <span class="main-product__save">Save {{ saving | money }}</span>
              {%- endif -%}
            </div>
            <div class="main-product__wishlist">{% render 'wishlist-button', product: product %}</div>
          </div>

          {%- if cart.taxes_included
            or shop.shipping_policy.body != blank
            or section.settings.product_message != blank
          -%}
            <div class="main-product__message rte">
              {% comment %}
                {%- if cart.taxes_included -%}{{ 'products.product.taxes_included' | t }}{%- endif -%}
                {%- if shop.shipping_policy.body != blank -%} {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
              {% endcomment %}
              {%- if section.settings.product_message != blank -%}
                <span>{{ section.settings.product_message }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- unless product.has_only_default_variant -%}
            <div class="main-product__variants">
              {% render 'product-variant-picker', product: product, block: section, product_form_id: product_form_id %}
            </div>
          {%- endunless -%}

          <div class="main-product__purchase">
            <div class="main-product__buy-buttons">
              {% if product.tags contains 'bundle' %}
                {%- for block in section.blocks -%}
                  {%- case block.type -%}
                    {% when '@app' %}
                      {% render block %}
                  {%- endcase -%}
                {%- endfor -%}
                {% render 'bundle-buy',
                  block: section,
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id,
                  show_pickup_availability: false,
                  show_product_price: true,
                  show_main_quantity: true
                %}
              {% else %}
                {% render 'buy-buttons',
                  block: section,
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id,
                  show_pickup_availability: false,
                  show_product_price: true,
                  show_main_quantity: true
                %}
              {% endif %}
            </div>
          </div>

          {%- for block in section.blocks -%}
            {%- if block.type == 'secure_checkout' -%}
              <div
                class="main-product__secure-checkout"
                style="--secure-checkout-padding-top: {{ block.settings.padding_top }}px; --secure-checkout-padding-bottom: {{ block.settings.padding_bottom }}px; --secure-checkout-title-size: {{ block.settings.title_size }}px; --secure-checkout-image-size: {{ block.settings.image_size }}px;"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.title != blank -%}
                  <div class="main-product__secure-checkout-title">{{ block.settings.title }}</div>
                {%- endif -%}
                <div class="main-product__secure-checkout-icons" role="list">
                  {%- for index in (1..6) -%}
                    {%- assign image_key = 'image_' | append: index -%}
                    {%- assign checkout_image = block.settings[image_key] -%}
                    {%- if checkout_image != blank -%}
                      <div class="main-product__secure-checkout-icon" role="listitem">
                        {{
                          checkout_image
                          | image_url: width: 240
                          | image_tag:
                            widths: '40, 60, 80, 100, 120, 160, 200, 240',
                            sizes: '(max-width: 749px) 15vw, 120px',
                            loading: 'lazy',
                            alt: checkout_image.alt
                        }}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'stock_notify' -%}
                {% render 'stock-notify', product: product, block: block %}
            {%- endcase -%}
          {%- endfor -%}

          <div class="main-product__benefits">
            {%- for block in section.blocks -%}
              {%- if block.type == 'benefit' and block.settings.text != blank -%}
                <div
                  class="main-product__benefit"
                  style="--benefit-icon-color:{{ block.settings.icon_color }};--benefit-text-color:{{ block.settings.text_color }};--benefit-icon-size:{{ block.settings.icon_size }}px;--benefit-text-size:{{ block.settings.text_size }}px"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.icon != 'none' -%}
                    <span class="main-product__benefit-icon">{% render 'icons', icon: block.settings.icon %}</span>
                  {%- endif -%}
                  <span>{{ block.settings.text }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- for block in section.blocks -%}
            {%- if block.type == 'pincode_checker' -%}
              <div
                class="cust-pincode-checker"
                data-cust-pincode-checker
                {% comment %}
                  NOTE:
                  This implementation intentionally uses the Delhivery API directly from the storefront.
                  The API token is therefore visible to storefront visitors.
                  The client has explicitly accepted this frontend-only architecture.
                {% endcomment %}
                data-delhivery-token="{{ block.settings.delhivery_api_token | escape }}"
                data-design-mode="{{ request.design_mode }}"
                data-show-cod="{{ block.settings.show_cod }}"
                data-show-prepaid="{{ block.settings.show_prepaid }}"
                data-show-location="{{ block.settings.show_location }}"
                data-loading-text="{{ block.settings.loading_text | escape }}"
                data-success-message="{{ block.settings.success_message | escape }}"
                data-unavailable-message="{{ block.settings.unavailable_message | escape }}"
                data-invalid-message="{{ block.settings.invalid_message | escape }}"
                data-error-message="{{ block.settings.error_message | escape }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.heading != blank -%}
                  <h2 class="cust-pincode-checker__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="cust-pincode-checker__description">{{ block.settings.description | escape }}</p>
                {%- endif -%}
                <form class="cust-pincode-checker__form" data-cust-pincode-form novalidate>
                  <label class="visually-hidden" for="CustPincode-{{ section.id }}-{{ block.id }}"
                    >Delivery pincode</label
                  >
                  <div class="cust-pincode-checker__row">
                    <input
                      class="cust-pincode-checker__input"
                      id="CustPincode-{{ section.id }}-{{ block.id }}"
                      name="pincode"
                      type="text"
                      inputmode="numeric"
                      autocomplete="postal-code"
                      maxlength="6"
                      pattern="[0-9]{6}"
                      placeholder="{{ block.settings.input_placeholder | escape }}"
                      aria-describedby="CustPincodeResult-{{ section.id }}-{{ block.id }}"
                      required
                      data-cust-pincode-input
                    >
                    <button class="cust-pincode-checker__button" type="submit" data-cust-pincode-submit>
                      <span data-cust-pincode-label>{{ block.settings.button_text | escape }}</span
                      ><span class="cust-pincode-checker__spinner" aria-hidden="true"></span>
                    </button>
                  </div>
                </form>
                <div
                  class="cust-pincode-checker__result"
                  id="CustPincodeResult-{{ section.id }}-{{ block.id }}"
                  aria-live="polite"
                  aria-atomic="true"
                  data-cust-pincode-result
                  hidden
                ></div>
              </div>
            {%- endif -%}
          {%- endfor -%}

          <div class="main-product__collapsibles">
            {%- for block in section.blocks -%}
              {%- if block.type == 'collapsible' -%}
                {%- assign panel_id = 'ProductCollapsible-' | append: section.id | append: '-' | append: block.id -%}
                <div class="main-product__collapsible" data-product-collapsible {{ block.shopify_attributes }}>
                  <button
                    class="main-product__collapsible-trigger"
                    type="button"
                    aria-expanded="{{ block.settings.open_by_default }}"
                    aria-controls="{{ panel_id }}"
                    data-collapsible-trigger
                  >
                    <span>{{ block.settings.heading | escape }}</span
                    ><span class="main-product__chevron" aria-hidden="true">
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </span>
                  </button>
                  <div class="main-product__collapsible-panel" id="{{ panel_id }}" data-collapsible-panel>
                    <div class="main-product__collapsible-content rte">{{ block.settings.content }}</div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'share_popup' -%}
                {% render 'product-share-popup', product: product, block: block %}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </product-component>
  {%- if section.settings.show_sticky_checkout -%}
    {%- assign sticky_form_id = 'sticky-product-form-' | append: section.id -%}
    {%- assign sticky_image = selected_variant.featured_image | default: product.featured_image -%}
    <div
      class="sticky-product-checkout"
      data-sticky-checkout
      data-display-mode="{{ section.settings.sticky_checkout_behavior }}"
      data-section-id="{{ section.id }}"
      aria-hidden="true"
    >
      <div class="sticky-product-checkout__inner">
        <div class="sticky-product-checkout__product">
          {%- if sticky_image != blank -%}
            {{
              sticky_image
              | image_url: width: 160
              | image_tag:
                class: 'sticky-product-checkout__image',
                widths: '80, 120, 160',
                sizes: '64px',
                loading: 'lazy',
                alt: product.title
            }}
          {%- endif -%}
          <div class="sticky-product-checkout__copy">
            <p class="sticky-product-checkout__title">{{ product.title | escape }}</p>
            <p class="sticky-product-checkout__price" data-sticky-price>{{ selected_variant.price | money }}</p>
          </div>
        </div>
        <product-form
          class="sticky-product-checkout__form product-form"
          data-hide-errors="false"
          data-section-id="{{ section.id }}"
        >
          <div class="product-form__error-message-wrapper sticky-product-checkout__error" role="alert" hidden>
            <span class="product-form__error-message"></span>
          </div>
          {%- form 'product',
            product,
            id: sticky_form_id,
            class: 'sticky-product-checkout__controls',
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form'
          -%}
            <input
              class="product-variant-id"
              type="hidden"
              name="id"
              value="{{ selected_variant.id }}"
              data-sticky-variant-id
              {% unless selected_variant.available %}
                disabled
              {% endunless %}
            >
            <quantity-input class="quantity sticky-product-checkout__quantity">
              <button class="quantity__button" name="minus" type="button">
                <span class="visually-hidden">
                  {{- 'products.product.quantity.decrease' | t: product: product.title -}}</span
                ><span class="svg-wrapper">{{ 'icon-minus.svg' | inline_asset_content }}</span>
              </button>
              <input
                class="quantity__input"
                type="number"
                name="quantity"
                value="{{ selected_variant.quantity_rule.min }}"
                min="{{ selected_variant.quantity_rule.min }}"
                data-min="{{ selected_variant.quantity_rule.min }}"
                {% if selected_variant.quantity_rule.max != null %}
                  max="{{ selected_variant.quantity_rule.max }}" data-max="{{ selected_variant.quantity_rule.max }}"
                {% endif %}
                step="{{ selected_variant.quantity_rule.increment }}"
                aria-label="{{ 'products.product.quantity.label' | t }}"
              >
              <button class="quantity__button" name="plus" type="button">
                <span class="visually-hidden">
                  {{- 'products.product.quantity.increase' | t: product: product.title -}}</span
                ><span class="svg-wrapper">{{ 'icon-plus.svg' | inline_asset_content }}</span>
              </button>
            </quantity-input>
            <button
              class="sticky-product-checkout__button button button--full-width"
              type="submit"
              name="add"
              {% unless selected_variant.available %}
                disabled aria-disabled="true"
              {% endunless %}
            >
              <span data-sticky-button-label>
                {%- if selected_variant.available -%}
                  {{- 'products.product.add_to_cart' | t -}}
                {%- else -%}
                  {{- 'products.product.sold_out' | t -}}
                {%- endif -%}
              </span>
              {%- render 'loading-spinner' -%}
            </button>
          {%- endform -%}
        </product-form>
      </div>
    </div>
  {%- endif -%}
</product-info>

{% render 'section-brand-colors', section: section %}

{% schema %}
{
  "name": "Main product",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Brand colors" },
    { "type": "color", "id": "brand_background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "brand_caption_color", "label": "Caption and eyebrow", "default": "#B86A8A" },
    { "type": "color", "id": "brand_heading_color", "label": "Headings", "default": "#341824" },
    { "type": "color", "id": "brand_text_color", "label": "Body text", "default": "#4A4145" },
    { "type": "color", "id": "brand_border_color", "label": "Borders", "default": "#F9D5E6" },
    { "type": "color", "id": "brand_button_background", "label": "Button background", "default": "#E83E8C" },{"type": "color", "id": "brand_button_background_mobile", "label": "Button background — Mobile", "default": "#EC64A4"},
    { "type": "color", "id": "brand_button_text_color", "label": "Button text", "default": "#FFFFFF" },
    { "type": "header", "content": "Sticky checkout" },
    { "type": "checkbox", "id": "show_sticky_checkout", "label": "Show sticky checkout", "default": true },
    {
      "type": "select",
      "id": "sticky_checkout_behavior",
      "label": "Display behavior",
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "after_buy_button", "label": "After scrolling past buy buttons" }
      ],
      "default": "after_buy_button",
      "visible_if": "{{ section.settings.show_sticky_checkout }}"
    },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#E64D95" },
    {
      "type": "inline_richtext",
      "id": "product_message",
      "label": "Additional product message",
      "info": "Use only for store-supported information such as COD availability."
    },
    {
      "type": "select",
      "id": "picker_type",
      "label": "Variant picker type",
      "default": "button",
      "options": [
        { "value": "button", "label": "Buttons" },
        { "value": "dropdown", "label": "Dropdown" }
      ]
    },
    {
      "type": "select",
      "id": "swatch_shape",
      "label": "Swatch shape",
      "default": "circle",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square" },
        { "value": "none", "label": "None" }
      ]
    },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Buy now button", "default": true },
    { "type": "checkbox", "id": "show_gift_card_recipient", "label": "Show gift-card recipient form", "default": true },
    { "type": "header", "content": "Desktop spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    { "type": "header", "content": "Mobile spacing" },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "secure_checkout",
      "name": "Secure checkout icons",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Secure checkout" },
        {
          "type": "range",
          "id": "title_size",
          "label": "Title size",
          "min": 10,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 14
        },
        {
          "type": "range",
          "id": "image_size",
          "label": "Image size",
          "min": 24,
          "max": 120,
          "step": 4,
          "unit": "px",
          "default": 48
        },
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
