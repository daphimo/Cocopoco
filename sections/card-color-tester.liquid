          }
        },
        {
          "type": "sample_card",
          "settings": {
            "heading": "Pink shade 5",
            "background_color": "#AC265A"
          }
        },
        {
          "type": "sample_card",
          "settings": {
            "heading": "Pink shade 6",
            "background_color": "#9D204E"
          }
        }
      ]
    }
  ]
}
{% endschema %}
