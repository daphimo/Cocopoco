<section class="card-color-tester page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="card-color-tester__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="card-color-tester__grid">
    {%- for block in section.blocks -%}
      <article
        class="card-color-tester__card"
        style="--card-background: {{ block.settings.background_color }}; --card-background-mobile: {{ block.settings.background_color_mobile }}; --card-text: {{ block.settings.text_color }};"
        {{ block.shopify_attributes }}
      >
        {{ forloop.index }}
        <span class="card-color-tester__swatch-value">{{ block.settings.background_color }}</span>
        <h3>{{ block.settings.heading | escape }}</h3>
        <div class="card-color-tester__text rte">{{ block.settings.text }}</div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .card-color-tester {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .card-color-tester__heading {
    margin: 0 0 2.4rem;
    text-align: center;
  }

  .card-color-tester__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.6rem;
  }

  .card-color-tester__card {
    min-height: 20rem;
    padding: 2.4rem;
    color: var(--card-text);
    background: var(--card-background);
    border-radius: 1.6rem;
    box-shadow: 0 1rem 3rem rgb(52 24 36 / 12%);
  }

  .card-color-tester__swatch-value {
    display: inline-block;
    margin-bottom: 2rem;
    padding: 0.4rem 0.8rem;
    color: inherit;
    background: rgb(0 0 0 / 12%);
    border-radius: 999px;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-color-tester__card h3 {
    margin: 0 0 1rem;
    color: inherit;
    font-size: 2rem;
  }

  .card-color-tester__text,
  .card-color-tester__text p {
    margin: 0;
    color: inherit;
  }

  @media screen and (max-width: 989px) {
    .card-color-tester__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .card-color-tester {
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .card-color-tester__grid {
      grid-template-columns: 1fr;
    }

    .card-color-tester__card {
      --card-background: var(--card-background-mobile);
      min-height: 16rem;
      padding: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
