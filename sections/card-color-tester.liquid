  "name": "Card color tester",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Card background color test"
    }
  ],
  "blocks": [
    {
      "type": "sample_card",
      "name": "Sample card",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Sample card"
