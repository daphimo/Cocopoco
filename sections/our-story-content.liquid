{{ 'our-story.css' | asset_url | stylesheet_tag }}
{%- style -%}#shopify-section-{{ section.id }}{--story-pt:{{ section.settings.padding_top }}px;--story-pb:{{ section.settings.padding_bottom }}px;--story-mpt:{{ section.settings.mobile_padding_top }}px;--story-mpb:{{ section.settings.mobile_padding_bottom }}px}{%- endstyle -%}
<section class="our-story-content"><div class="our-story-content__container"><div class="our-story-content__body rte">{{ section.settings.content }}</div></div></section>
{% render 'section-brand-colors', section: section %}

