pup__video--desktop{filter:blur(var(--exit-desktop-blur));transform:scale(1.05)}.exit-popup__image-overlay{background:#000;opacity:var(--exit-image-overlay)}.exit-popup__close{position:absolute;z-index:3;top:12px;right:12px;display:grid;place-items:center;width:44px;height:44px;padding:0;color:currentColor;background:rgba(255,255,255,.8);border:0;border-radius:50%;cursor:pointer}.exit-popup__close svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}.exit-popup__content{display:flex;flex-direction:column;justify-content:center;min-height:var(--exit-min-height);padding:var(--exit-padding)}.exit-popup__heading{margin:0 0 var(--exit-space);color:var(--exit-color);font-size:var(--exit-size);font-weight:var(--exit-weight);line-height:1.1;text-align:var(--exit-align)}.exit-popup__subheading{margin:0 0 var(--exit-space);color:var(--exit-color);font-size:var(--exit-size);line-height:1.45;text-align:var(--exit-align)}.exit-popup__countdown,.exit-popup__action{margin:0 0 var(--exit-space);text-align:var(--exit-align)}.exit-popup__timer{display:inline-flex;align-items:flex-start;gap:12px}.exit-popup__timer span{display:grid;gap:4px;text-align:center}.exit-popup__timer strong{color:var(--exit-number-color);font-size:var(--exit-number-size);font-variant-numeric:tabular-nums;line-height:1}.exit-popup__timer b{color:var(--exit-number-color);font-size:var(--exit-number-size);font-weight:400;line-height:.9}.exit-popup__timer small{color:var(--exit-label-color);font-size:var(--exit-label-size);line-height:1;text-transform:uppercase}.exit-popup__cta,.exit-popup__copy{display:inline-flex;align-items:center;justify-content:center;padding:var(--exit-vpad) var(--exit-hpad);color:var(--exit-color);background:var(--exit-bg);border:var(--exit-border-width,1px) solid var(--exit-border-color);border-radius:var(--exit-radius);font:inherit;font-size:var(--exit-size);font-weight:var(--exit-weight,700);line-height:1.2;text-decoration:none;cursor:pointer}.exit-popup__email{margin:0 0 var(--exit-space);text-align:var(--exit-align)}.exit-popup__email-form{display:inline-block;width:min(100%,560px);text-align:left}.exit-popup__email-label{display:block;margin:0 0 7px;color:var(--exit-field-color);font-size:var(--exit-field-size);font-weight:600}.exit-popup__email-fields{display:flex;gap:8px}.exit-popup__email-input,.exit-popup__email-button{min-height:48px;border:1px solid;border-radius:var(--exit-field-radius);font:inherit;font-size:var(--exit-field-size)}.exit-popup__email-input{min-width:0;flex:1;padding:10px 14px;color:var(--exit-field-color);background:var(--exit-field-bg);border-color:var(--exit-field-border)}.exit-popup__email-input::placeholder{color:inherit;opacity:.62}.exit-popup__email-button{flex:0 0 auto;padding:10px 22px;color:var(--exit-button-color);background:var(--exit-button-bg);border-color:var(--exit-button-border);font-weight:700;cursor:pointer}.exit-popup__email-button[disabled]{cursor:wait;opacity:.7}.exit-popup__email-status{margin:8px 0 0;color:var(--exit-field-color);font-size:calc(var(--exit-field-size) - 2px);line-height:1.35}.exit-popup__email-status.is-error{color:#ffd7d7}.exit-popup__close:focus-visible,.exit-popup__cta:focus-visible,.exit-popup__copy:focus-visible,.exit-popup__email-input:focus-visible,.exit-popup__email-button:focus-visible{outline:3px solid currentColor;outline-offset:3px}.exit-popup--animation-scale .exit-popup__dialog{transition:transform var(--exit-animation-duration) ease;transform:scale(calc(var(--exit-desktop-scale) * .86))}.exit-popup--animation-scale.is-open .exit-popup__dialog{transform:scale(var(--exit-desktop-scale))}.exit-popup--animation-slide-up .exit-popup__dialog{transition:transform var(--exit-animation-duration) ease;transform:translateY(48px) scale(var(--exit-desktop-scale))}.exit-popup--animation-slide-down .exit-popup__dialog{transition:transform var(--exit-animation-duration) ease;transform:translateY(-48px) scale(var(--exit-desktop-scale))}.exit-popup--animation-slide-left .exit-popup__dialog{transition:transform var(--exit-animation-duration) ease;transform:translateX(48px) scale(var(--exit-desktop-scale))}.exit-popup--animation-slide-right .exit-popup__dialog{transition:transform var(--exit-animation-duration) ease;transform:translateX(-48px) scale(var(--exit-desktop-scale))}.exit-popup--animation-slide-up.is-open .exit-popup__dialog,.exit-popup--animation-slide-down.is-open .exit-popup__dialog,.exit-popup--animation-slide-left.is-open .exit-popup__dialog,.exit-popup--animation-slide-right.is-open .exit-popup__dialog{transform:scale(var(--exit-desktop-scale))}
    @media(max-width:749px){.exit-popup__positioner{padding:12px}.exit-popup--mobile-center .exit-popup__positioner{align-items:center;justify-content:center}.exit-popup--mobile-top-center .exit-popup__positioner{align-items:flex-start;justify-content:center}.exit-popup--mobile-bottom-center .exit-popup__positioner{align-items:flex-end;justify-content:center}.exit-popup--mobile-top-left .exit-popup__positioner{align-items:flex-start;justify-content:flex-start}.exit-popup--mobile-top-right .exit-popup__positioner{align-items:flex-start;justify-content:flex-end}.exit-popup--mobile-bottom-left .exit-popup__positioner{align-items:flex-end;justify-content:flex-start}.exit-popup--mobile-bottom-right .exit-popup__positioner{align-items:flex-end;justify-content:flex-end}.exit-popup__dialog{width:min(calc(100vw - 24px),var(--exit-max-width));max-height:calc(100dvh - 24px);transform:scale(var(--exit-mobile-scale));background:var(--exit-mobile-gradient)}.exit-popup__media--desktop{display:none}.exit-popup__media--mobile{display:block}.exit-popup__video--mobile{filter:blur(var(--exit-mobile-blur));transform:scale(1.05)}.exit-popup__content{padding:calc(var(--exit-padding) * .72)}.exit-popup__heading{font-size:var(--exit-mobile-size)}.exit-popup__subheading{font-size:var(--exit-mobile-size)}.exit-popup__timer{gap:7px}.exit-popup__email-fields{flex-direction:column}.exit-popup__email-button{width:100%}.exit-popup--animation-scale .exit-popup__dialog{transform:scale(calc(var(--exit-mobile-scale) * .86))}.exit-popup--animation-scale.is-open .exit-popup__dialog,.exit-popup--animation-slide-up.is-open .exit-popup__dialog,.exit-popup--animation-slide-down.is-open .exit-popup__dialog,.exit-popup--animation-slide-left.is-open .exit-popup__dialog,.exit-popup--animation-slide-right.is-open .exit-popup__dialog{transform:scale(var(--exit-mobile-scale))}}
    @media(prefers-reduced-motion:reduce){.exit-popup,.exit-popup__dialog{transition:none!important}}
  </style>

  <script>
    (() => {
      const root = document.getElementById('ExitIntentPopup-{{ section.id }}');
      const configNode = document.querySelector('[data-exit-popup-config="{{ section.id }}"]');
      if (!root || !configNode) return;

      window.ExitIntentPopups = window.ExitIntentPopups || {};
      window.ExitIntentPopups[{{ section.id | json }}]?.destroy?.();

      let config;
      try { config = JSON.parse(configNode.textContent); } catch (error) { return; }

      const dialog = root.querySelector('[role="dialog"]');
      const countdown = root.querySelector('[data-exit-countdown]');
      const storageKey = `exitIntentShown:${config.sectionId}`;
      const mobileQuery = window.matchMedia('(max-width: 749px)');
      const focusableSelector = 'a[href],button:not([disabled]),[tabindex]:not([tabindex="-1"])';
      let popupShown = false;
      let isOpen = false;
      let previousFocus = null;
      let triggerTimer = null;
      let countdownTimer = null;
      let enableTimer = null;

      const wasShown = () => {
        if (!config.showOnce || config.designMode) return false;
        try { return sessionStorage.getItem(storageKey) === 'true'; } catch (error) { return false; }
      };
      const markShown = () => {
        if (!config.showOnce || config.designMode) return;
        try { sessionStorage.setItem(storageKey, 'true'); } catch (error) {}
      };
      const loadActiveVideo = () => {
        const selector = mobileQuery.matches ? '.exit-popup__media--mobile[data-exit-video]' : '.exit-popup__media--desktop[data-exit-video]';
        const video = root.querySelector(selector);
        if (!video) return;
        const source = video.querySelector('source[data-src]');
        if (source && !source.src) { source.src = source.dataset.src; video.load(); }
        video.play().catch(() => {});
      };
      const stopVideos = () => root.querySelectorAll('video').forEach((video) => video.pause());
      const close = () => {
        if (!isOpen) return;
        isOpen = false;
        root.classList.remove('is-open');
        markShown();
        stopVideos();
        window.setTimeout(() => { if (!isOpen) root.hidden = true; }, Number.parseFloat(getComputedStyle(root).getPropertyValue('--exit-animation-duration')) * 1000 || 0);
        previousFocus?.focus?.();
      };
      const startCountdown = () => {
        if (!countdown) return;
        const duration = Math.max(0, Number(countdown.dataset.duration) || 0) * 1000;
        if (!duration) return;
        let endTime = Date.now() + duration;
        const render = () => {
          let remaining = Math.max(0, endTime - Date.now());
          if (remaining <= 0) {
            if (countdown.dataset.expiry === 'loop') { endTime = Date.now() + duration; remaining = duration; }
            else {
              window.clearInterval(countdownTimer);
              countdownTimer = null;
              if (countdown.dataset.expiry === 'hide') close();
            }
          }
          const totalSeconds = Math.ceil(remaining / 1000);
          countdown.querySelector('[data-exit-hours]').textContent = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
          countdown.querySelector('[data-exit-minutes]').textContent = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
          countdown.querySelector('[data-exit-seconds]').textContent = String(totalSeconds % 60).padStart(2, '0');
        };
        render();
        countdownTimer = window.setInterval(render, 250);
      };
      const show = (forceEditorPreview = false) => {
        const forceShow = forceEditorPreview && config.designMode;
        if (!forceShow && (popupShown || wasShown())) return;
        if (forceShow) {
          popupShown = false;
          window.clearInterval(countdownTimer);
          countdownTimer = null;
        }
        popupShown = true;
        isOpen = true;
        document.removeEventListener('mouseout', onMouseOut);
        window.clearTimeout(triggerTimer);
        previousFocus = document.activeElement;
        root.hidden = false;
        loadActiveVideo();
        startCountdown();
        requestAnimationFrame(() => {
          root.classList.add('is-open');
          dialog.focus({ preventScroll: true });
        });
      };
      const onMouseOut = (event) => {
        if (event.relatedTarget !== null || event.clientY > config.topThreshold) return;
        show();
      };
      const onKeydown = (event) => {
        if (!isOpen) return;
        if (event.key === 'Escape') { close(); return; }
        if (event.key !== 'Tab') return;
        const focusable = [...dialog.querySelectorAll(focusableSelector)].filter((item) => item.offsetParent !== null);
        if (!focusable.length) { event.preventDefault(); dialog.focus(); return; }
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      };
      const schedule = () => {
        if (wasShown()) return;
        if (config.designMode) return;
        if (mobileQuery.matches) triggerTimer = window.setTimeout(show, config.mobileDelay);
        else if (config.triggerType === 'delay') triggerTimer = window.setTimeout(show, config.desktopDelay);
        else enableTimer = window.setTimeout(() => document.addEventListener('mouseout', onMouseOut), config.initializationDelay);
      };
      const eventMatchesSection = (event) => String(event.detail?.sectionId || '') === String(config.sectionId);
      const onSectionUnload = (event) => { if (eventMatchesSection(event)) destroy(); };
      const onSectionSelect = (event) => {
        if (!eventMatchesSection(event)) return;
        window.ExitIntentPopups.selectedSectionId = String(config.sectionId);
        show(true);
      };
      const onSectionDeselect = (event) => {
        if (!eventMatchesSection(event)) return;
        if (window.ExitIntentPopups.selectedSectionId === String(config.sectionId)) window.ExitIntentPopups.selectedSectionId = null;
        close();
      };
      const onBlockSelect = (event) => {
        if (!eventMatchesSection(event)) return;
        window.ExitIntentPopups.selectedSectionId = String(config.sectionId);
        show(true);
      };
      const destroy = () => {
        document.removeEventListener('mouseout', onMouseOut);
        document.removeEventListener('keydown', onKeydown);
        document.removeEventListener('shopify:section:unload', onSectionUnload);
        document.removeEventListener('shopify:section:select', onSectionSelect);
        document.removeEventListener('shopify:section:deselect', onSectionDeselect);
        document.removeEventListener('shopify:block:select', onBlockSelect);
        window.clearTimeout(triggerTimer);
        window.clearTimeout(enableTimer);
        window.clearInterval(countdownTimer);
        stopVideos();
        root.remove();
        configNode.remove();
      };

      root.querySelectorAll('[data-exit-close]').forEach((button) => button.addEventListener('click', close));
      root.querySelectorAll('[data-exit-copy]').forEach((button) => button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.code);
        } catch (error) {
          const input = document.createElement('textarea');
          input.value = button.dataset.code;
          input.style.position = 'fixed';
          input.style.opacity = '0';
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          input.remove();
        }
        button.textContent = button.dataset.success;
        button.parentElement.querySelector('[data-exit-copy-status]').textContent = button.dataset.success;
        window.setTimeout(() => { button.textContent = button.dataset.label; }, 2200);
      }));
      root.querySelectorAll('[data-exit-email-form]').forEach((form) => form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (form.dataset.submitting === 'true') return;
        const email = form.querySelector('input[type="email"]');
        const submit = form.querySelector('[data-exit-email-submit]');
        const status = form.querySelector('[data-exit-email-status]');
        email.value = email.value.trim();
        if (!email.validity.valid) {
          email.setAttribute('aria-invalid', 'true');
          status.textContent = status.dataset.invalid;
          status.classList.add('is-error');
          status.hidden = false;
          email.focus();
          return;
        }
        email.removeAttribute('aria-invalid');
        status.hidden = true;
        status.classList.remove('is-error');
        form.dataset.submitting = 'true';
        submit.disabled = true;
        try {
          const response = await fetch(form.action.split('#')[0], {
            method: 'POST',
            body: new URLSearchParams(new FormData(form)),
            credentials: 'same-origin',
            headers: {
              Accept: 'text/html',
              'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
              'X-Requested-With': 'XMLHttpRequest',
            },
          });
          if (!response.ok) throw new Error(`Subscription failed with status ${response.status}`);
          form.querySelector('.exit-popup__email-fields').hidden = true;
          form.querySelector('.exit-popup__email-label')?.setAttribute('hidden', '');
          status.textContent = status.dataset.success;
          status.hidden = false;
          markShown();
        } catch (error) {
          status.textContent = status.dataset.error;
          status.classList.add('is-error');
          status.hidden = false;
          form.dataset.submitting = 'false';
          submit.disabled = false;
        }
      }));
      document.addEventListener('keydown', onKeydown);
      document.addEventListener('shopify:section:unload', onSectionUnload);
      document.addEventListener('shopify:section:select', onSectionSelect);
      document.addEventListener('shopify:section:deselect', onSectionDeselect);
      document.addEventListener('shopify:block:select', onBlockSelect);
      window.ExitIntentPopups[config.sectionId] = { destroy, show, close };

      const sectionContainer = root.closest('.shopify-section');
      const isSelectedInEditor = config.designMode && (
        window.ExitIntentPopups.selectedSectionId === String(config.sectionId) ||
        sectionContainer?.classList.contains('shopify-section--selected')
      );
      if (isSelectedInEditor) {
        window.ExitIntentPopups.selectedSectionId = String(config.sectionId);
        show(true);
      } else {
        schedule();
      }
    })();
  </script>
{%- endif -%}

