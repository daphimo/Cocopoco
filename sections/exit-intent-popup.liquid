{%- if section.settings.enable_popup -%}
  {%- liquid
    assign desktop_gradient = section.settings.desktop_gradient_1
    if section.settings.desktop_gradient_type == 'radial'
      capture desktop_gradient
        echo 'radial-gradient(circle, '
        echo section.settings.desktop_gradient_1
        echo ', '
        echo section.settings.desktop_gradient_2
        echo ')'
      endcapture
    else
      capture desktop_gradient
        echo 'linear-gradient('
        echo section.settings.desktop_gradient_angle
        echo 'deg, '
        echo section.settings.desktop_gradient_1
        echo ', '
        echo section.settings.desktop_gradient_2
        echo ')'
      endcapture
    endif

    assign mobile_gradient = section.settings.mobile_gradient_1
    if section.settings.mobile_gradient_type == 'radial'
      capture mobile_gradient
        echo 'radial-gradient(circle, '
        echo section.settings.mobile_gradient_1
        echo ', '
        echo section.settings.mobile_gradient_2
        echo ')'
      endcapture
    else
      capture mobile_gradient
        echo 'linear-gradient('
        echo section.settings.mobile_gradient_angle
        echo 'deg, '
        echo section.settings.mobile_gradient_1
        echo ', '
        echo section.settings.mobile_gradient_2
        echo ')'
      endcapture
    endif
  -%}

  <div
    id="ExitIntentPopup-{{ section.id }}"
    class="exit-popup exit-popup--desktop-{{ section.settings.desktop_position }} exit-popup--mobile-{{ section.settings.mobile_position }} exit-popup--animation-{{ section.settings.animation }}"
    style="
      --exit-desktop-scale: {{ section.settings.desktop_scale | divided_by: 100.0 }};
      --exit-mobile-scale: {{ section.settings.mobile_scale | divided_by: 100.0 }};
      --exit-max-width: {{ section.settings.popup_width }}px;
      --exit-min-height: {{ section.settings.popup_height }}px;
      --exit-radius: {{ section.settings.popup_radius }}px;
      --exit-padding: {{ section.settings.content_padding }}px;
      --exit-overlay-color: {{ section.settings.overlay_color }};
      --exit-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      --exit-animation-duration: {{ section.settings.animation_duration | divided_by: 1000.0 }}s;
      --exit-desktop-gradient: {{ desktop_gradient }};
      --exit-mobile-gradient: {{ mobile_gradient }};
      --exit-desktop-blur: {{ section.settings.desktop_video_blur }}px;
      --exit-mobile-blur: {{ section.settings.mobile_video_blur }}px;
      --exit-image-overlay: {{ section.settings.image_overlay | divided_by: 100.0 }};
    "
    data-exit-popup
    data-section-id="{{ section.id }}"
    hidden
    {{ section.shopify_attributes }}
  >
    {%- if section.settings.enable_overlay -%}
      <button class="exit-popup__overlay" type="button" data-exit-close aria-label="Close offer"></button>
    {%- endif -%}

    <div class="exit-popup__positioner">
      <div class="exit-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="ExitPopupTitle-{{ section.id }}" tabindex="-1">
        <span class="visually-hidden" id="ExitPopupTitle-{{ section.id }}">Special offer</span>
        <div class="exit-popup__background" aria-hidden="true">
          {%- case section.settings.desktop_background_type -%}
            {%- when 'image' -%}
              {%- if section.settings.desktop_image != blank -%}
                {{ section.settings.desktop_image | image_url: width: 1800 | image_tag: class: 'exit-popup__media exit-popup__media--desktop', loading: 'lazy', widths: '600, 900, 1200, 1500, 1800', sizes: '100vw' }}
              {%- endif -%}
            {%- when 'video' -%}
              {%- if section.settings.desktop_video_url != blank -%}
                <video class="exit-popup__media exit-popup__media--desktop exit-popup__video--desktop" muted loop playsinline preload="none" data-exit-video>
                  <source data-src="{{ section.settings.desktop_video_url | escape }}" type="video/mp4">
                </video>
              {%- endif -%}
          {%- endcase -%}

          {%- case section.settings.mobile_background_type -%}
            {%- when 'image' -%}
              {%- if section.settings.mobile_image != blank -%}
                {{ section.settings.mobile_image | image_url: width: 1000 | image_tag: class: 'exit-popup__media exit-popup__media--mobile', loading: 'lazy', widths: '360, 540, 750, 1000', sizes: '100vw' }}
              {%- endif -%}
            {%- when 'video' -%}
              {%- if section.settings.mobile_video_url != blank -%}
                <video class="exit-popup__media exit-popup__media--mobile exit-popup__video--mobile" muted loop playsinline preload="none" data-exit-video>
                  <source data-src="{{ section.settings.mobile_video_url | escape }}" type="video/mp4">
                </video>
              {%- endif -%}
          {%- endcase -%}
          <span class="exit-popup__image-overlay"></span>
        </div>

        <button class="exit-popup__close" type="button" data-exit-close aria-label="Close offer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>

        <div class="exit-popup__content">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                <h2
                  class="exit-popup__heading"
                  style="--exit-size:{{ block.settings.font_size }}px;--exit-mobile-size:{{ block.settings.mobile_font_size }}px;--exit-weight:{{ block.settings.font_weight }};--exit-color:{{ block.settings.color }};--exit-align:{{ block.settings.alignment }};--exit-space:{{ block.settings.bottom_spacing }}px;"
                  {{ block.shopify_attributes }}
                >{{ block.settings.text | escape }}</h2>
              {%- when 'subheading' -%}
                <div
                  class="exit-popup__subheading"
                  style="--exit-size:{{ block.settings.font_size }}px;--exit-mobile-size:{{ block.settings.mobile_font_size }}px;--exit-color:{{ block.settings.color }};--exit-align:{{ block.settings.alignment }};--exit-space:{{ block.settings.bottom_spacing }}px;"
                  {{ block.shopify_attributes }}
                >{{ block.settings.text | escape | newline_to_br }}</div>
              {%- when 'countdown' -%}
                {%- if block.settings.enable -%}
                  {%- liquid
                    assign countdown_hours = block.settings.hours | times: 3600
                    assign countdown_minutes = block.settings.minutes | times: 60
                    assign countdown_duration = countdown_hours | plus: countdown_minutes | plus: block.settings.seconds
                  -%}
                  <div
                    class="exit-popup__countdown"
                    data-exit-countdown
                    data-duration="{{ countdown_duration }}"
                    data-expiry="{{ block.settings.expiry_behavior }}"
                    style="--exit-number-size:{{ block.settings.number_size }}px;--exit-label-size:{{ block.settings.label_size }}px;--exit-number-color:{{ block.settings.number_color }};--exit-label-color:{{ block.settings.label_color }};--exit-align:{{ block.settings.alignment }};--exit-space:{{ block.settings.bottom_spacing }}px;"
                    {{ block.shopify_attributes }}
                  >
                    <div class="exit-popup__timer" role="timer" aria-live="off" aria-label="Offer countdown">
                      <span><strong data-exit-hours>00</strong><small>{{ block.settings.hours_label | escape }}</small></span>
                      <b aria-hidden="true">:</b>
                      <span><strong data-exit-minutes>00</strong><small>{{ block.settings.minutes_label | escape }}</small></span>
                      <b aria-hidden="true">:</b>
                      <span><strong data-exit-seconds>00</strong><small>{{ block.settings.seconds_label | escape }}</small></span>
                    </div>
                  </div>
                {%- endif -%}
              {%- when 'cta' -%}
                {%- if block.settings.text != blank and block.settings.link != blank -%}
                  <div class="exit-popup__action" style="--exit-align:{{ block.settings.alignment }};--exit-space:{{ block.settings.bottom_spacing }}px;" {{ block.shopify_attributes }}>
                    <a
                      class="exit-popup__cta"
                      href="{{ block.settings.link }}"
                      style="--exit-bg:{{ block.settings.background }};--exit-color:{{ block.settings.color }};--exit-border-color:{{ block.settings.border_color }};--exit-border-width:{{ block.settings.border_width }}px;--exit-radius:{{ block.settings.border_radius }}px;--exit-size:{{ block.settings.font_size }}px;--exit-weight:{{ block.settings.font_weight }};--exit-vpad:{{ block.settings.vertical_padding }}px;--exit-hpad:{{ block.settings.horizontal_padding }}px;"
                      {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                    >{{ block.settings.text | escape }}</a>
                  </div>
                {%- endif -%}
              {%- when 'discount' -%}
                {%- if block.settings.code != blank -%}
                  <div class="exit-popup__action" style="--exit-align:{{ block.settings.alignment }};--exit-space:{{ block.settings.bottom_spacing }}px;" {{ block.shopify_attributes }}>
                    <button
                      class="exit-popup__copy"
                      type="button"
                      data-exit-copy
                      data-code="{{ block.settings.code | escape }}"
                      data-label="{{ block.settings.button_text | escape }}"
                      data-success="{{ block.settings.success_text | escape }}"
                      style="--exit-bg:{{ block.settings.background }};--exit-color:{{ block.settings.color }};--exit-border-color:{{ block.settings.border_color }};--exit-radius:{{ block.settings.border_radius }}px;--exit-size:{{ block.settings.font_size }}px;--exit-vpad:{{ block.settings.vertical_padding }}px;--exit-hpad:{{ block.settings.horizontal_padding }}px;"
                    >{{ block.settings.button_text | escape }}</button>
                    <span class="visually-hidden" data-exit-copy-status role="status" aria-live="polite"></span>
                  </div>
                {%- endif -%}
              {%- when 'email_subscription' -%}
                {%- assign email_form_id = 'ExitPopupEmailForm-' | append: block.id -%}
                <div
                  class="exit-popup__email"
                  style="--exit-align:{{ block.settings.alignment }};--exit-space:{{ block.settings.bottom_spacing }}px;--exit-field-bg:{{ block.settings.input_background }};--exit-field-color:{{ block.settings.input_color }};--exit-field-border:{{ block.settings.input_border_color }};--exit-button-bg:{{ block.settings.button_background }};--exit-button-color:{{ block.settings.button_color }};--exit-button-border:{{ block.settings.button_border_color }};--exit-field-radius:{{ block.settings.border_radius }}px;--exit-field-size:{{ block.settings.font_size }}px;"
                  {{ block.shopify_attributes }}
                >
                  {%- form 'customer', id: email_form_id, class: 'exit-popup__email-form', novalidate: 'novalidate', data-exit-email-form: '' -%}
                    <input type="hidden" name="contact[tags]" value="newsletter,exit-intent-popup">
                    {%- if block.settings.label != blank -%}
                      <label class="exit-popup__email-label" for="ExitPopupEmail-{{ block.id }}">{{ block.settings.label | escape }}</label>
                    {%- endif -%}
                    <div class="exit-popup__email-fields">
                      <input
                        class="exit-popup__email-input"
                        id="ExitPopupEmail-{{ block.id }}"
                        type="email"
                        name="contact[email]"
                        autocomplete="email"
                        autocapitalize="off"
                        spellcheck="false"
                        placeholder="{{ block.settings.placeholder | escape }}"
                        aria-describedby="ExitPopupEmailStatus-{{ block.id }}"
                        required
                      >
                      <button class="exit-popup__email-button" type="submit" data-exit-email-submit>{{ block.settings.button_text | escape }}</button>
                    </div>
                    <p
                      class="exit-popup__email-status"
                      id="ExitPopupEmailStatus-{{ block.id }}"
                      data-exit-email-status
                      data-success="{{ block.settings.success_text | escape }}"
                      data-invalid="{{ block.settings.invalid_text | escape }}"
                      data-error="{{ block.settings.error_text | escape }}"
                      role="status"
                      aria-live="polite"
                      hidden
                    ></p>
                  {%- endform -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-exit-popup-config="{{ section.id }}">
    {
      "sectionId": {{ section.id | json }},
      "triggerType": {{ section.settings.trigger_type | json }},
      "topThreshold": {{ section.settings.top_threshold | json }},
      "initializationDelay": {{ section.settings.initialization_delay | times: 1000 | json }},
      "desktopDelay": {{ section.settings.desktop_delay | times: 1000 | json }},
      "mobileDelay": {% if section.settings.separate_mobile_delay %}{{ section.settings.mobile_delay | times: 1000 | json }}{% else %}{{ section.settings.desktop_delay | times: 1000 | json }}{% endif %},
      "showOnce": {{ section.settings.show_once | json }},
      "desktopBackground": {{ section.settings.desktop_background_type | json }},
      "mobileBackground": {{ section.settings.mobile_background_type | json }},
      "designMode": {{ request.design_mode | json }}
    }
  </script>

  <style>
